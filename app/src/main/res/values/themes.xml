<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.CodeForces" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/surface_black</item>
        <item name="android:statusBarColor">@color/surface_black</item>
        <item name="android:navigationBarColor">@color/surface_black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="colorPrimary">@color/rank_pupil_primary</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <!-- Material components dark overrides -->
        <item name="materialCardViewStyle">@style/CFCardStyle</item>
        <item name="bottomNavigationStyle">@style/CFBottomNavStyle</item>
        <item name="chipStyle">@style/CFChipStyle</item>
    </style>

    <!-- Flat sharp card — no elevation, dark bg, gray stroke -->
    <style name="CFCardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardBackgroundColor">@color/surface_container</item>
        <item name="strokeColor">@color/stroke_gray</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TransparentIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Dark bottom nav -->
    <style name="CFBottomNavStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface_black</item>
        <item name="itemRippleColor">@color/stroke_gray</item>
        <item name="itemTextAppearanceActive">@style/CFNavLabelActive</item>
        <item name="itemTextAppearanceInactive">@style/CFNavLabelInactive</item>
        <item name="itemActiveIndicatorStyle">@style/TransparentIndicator</item>
    </style>

    <style name="CFNavLabelActive">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="CFNavLabelInactive">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Dark chip style -->
    <style name="CFChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="chipBackgroundColor">@color/surface_container</item>
        <item name="chipStrokeColor">@color/stroke_gray</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">0dp</item>
    </style>

    <!-- Dark outlined text input -->
    <style name="CFInputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_container</item>
        <item name="boxStrokeColor">@color/stroke_gray</item>
        <item name="hintTextColor">@color/on_surface_variant</item>
        <item name="android:textColorHint">@color/on_surface_variant</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface_black</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.CodeForces</item>
    </style>

    <style name="CFToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
