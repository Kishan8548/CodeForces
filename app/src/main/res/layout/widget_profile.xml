<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_border"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#404040"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#000000">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/cf_logo" />

        <TextView
            android:id="@+id/widget_app_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:fontFamily="sans-serif-black"
            android:textColor="#A0A0A0"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.05" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_refresh"
            android:padding="4dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#404040"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Handle & Rank -->
    <TextView
        android:id="@+id/widget_handle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="tourist" />

    <TextView
        android:id="@+id/widget_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textColor="#80FFFFFF"
        android:textAllCaps="true"
        android:text="legendary grandmaster"
        android:layout_marginTop="2dp" />

    <FrameLayout
        android:id="@+id/widget_divider_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#404040"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Stats -->
    <LinearLayout
        android:id="@+id/widget_stats_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Current Rating -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_rating_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RATING"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textColor="#A0A0A0" />

            <TextView
                android:id="@+id/widget_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="3999" />
        </LinearLayout>

        <!-- Max Rating -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_max_rating_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textColor="#A0A0A0" />

            <TextView
                android:id="@+id/widget_max_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="4000" />
        </LinearLayout>

        <!-- Solved Today -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_todays_submission_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TODAY"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:textColor="#A0A0A0" />

                <ImageView
                    android:id="@+id/checkSubmission"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/baseline_check_circle_24"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_todays_submission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="0" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
</FrameLayout>