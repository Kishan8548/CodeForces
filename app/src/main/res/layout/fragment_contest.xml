<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_black"
    android:fitsSystemWindows="true">

    <!-- ── HEADER ──────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTESTS"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/on_surface"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High-stakes competitive programming"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- FILTER SPINNER ─────────────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FILTER"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textColor="@color/on_surface_variant"
                android:letterSpacing="0.2"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/dropdownSort"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_outlined_button"
                android:paddingStart="10dp"
                android:paddingEnd="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── SEPARATOR ───────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_gray" />

    <!-- ── LIST CONTAINER ────────────────────────────── -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshContest"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewContests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="80dp" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerContests"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:shimmer_duration="1200"
            app:shimmer_base_alpha="0.3"
            app:shimmer_highlight_alpha="0.7">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp">

                <include layout="@layout/item_contest_skeleton" />
                <include layout="@layout/item_contest_skeleton" />
                <include layout="@layout/item_contest_skeleton" />

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬚"
                android:textSize="64sp"
                android:textColor="@color/stroke_gray_medium"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NO CONTESTS FOUND"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/on_surface_variant"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pull to refresh or change filter"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>