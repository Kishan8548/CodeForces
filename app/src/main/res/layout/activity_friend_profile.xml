<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/surface_black">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container_low"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@color/on_surface"
            app:title="FRIEND PROFILE"
            app:titleTextAppearance="@style/CFToolbarTitle" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Profile Info Bento -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dark_card"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <!-- Avatar & Handle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:id="@+id/profileAvatarContainer"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@color/rank_newbie_primary"
                            android:padding="2dp"
                            android:layout_marginEnd="16dp">
                            <ImageView
                                android:id="@+id/profileFriendAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_profile" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/profileFriendRank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MASTER"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textColor="@color/rank_newbie_primary"
                                android:background="@drawable/bg_rank_badge_dark"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/profileFriendHandle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="tourist_fan_99"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/rank_newbie_primary" />
                                
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Stats Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/cardFriendRating"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_dark_card"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RATING"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textColor="@color/on_surface_variant"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/profileFriendRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2348"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:textColor="@color/rank_newbie_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardFriendContributions"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_dark_card"
                            android:padding="12dp"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CONTRIBUTIONS"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textColor="@color/on_surface_variant"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/profileFriendContributions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+84"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:textColor="@color/on_surface" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:paddingTop="16dp">

                        <TextView
                            android:id="@+id/btnProfileUnfriend"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="UNFRIEND"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textColor="@color/danger_red"
                            android:background="@drawable/bg_outlined_button"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/btnProfileShare"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="SHARE"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textColor="@color/on_surface_variant"
                            android:background="@drawable/bg_dark_card"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Head-to-Head Comparison -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HEAD-TO-HEAD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:textColor="@color/on_surface_variant"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/cardFriendHeadToHead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dark_card"
                    android:padding="16dp"
                    android:layout_marginBottom="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contests Entered"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YOU"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/profileMyContests"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/profileFriendContests"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="84"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="@color/rank_newbie_primary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tvFriendContestsLabelHim"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HIM"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:textColor="@color/rank_newbie_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:orientation="horizontal"
                        android:background="@color/surface_black">
                        <View
                            android:id="@+id/profileContestsMyBar"
                            android:layout_width="0dp"
                            android:layout_weight="0.15"
                            android:layout_height="match_parent"
                            android:background="@color/on_surface" />
                        <View
                            android:id="@+id/profileContestsFriendBar"
                            android:layout_width="0dp"
                            android:layout_weight="0.85"
                            android:layout_height="match_parent"
                            android:background="@color/rank_newbie_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Recent Submissions Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:id="@+id/indicatorFriendRecentSubmissions"
                        android:layout_width="16dp"
                        android:layout_height="4dp"
                        android:background="@color/rank_newbie_primary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="RECENT SUBMISSIONS"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.05"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/btnViewAllSubmissions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIEW ALL →"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/rank_newbie_primary"
                        android:padding="8dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Submissions Table Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp"
                    android:paddingHorizontal="8dp"
                    android:background="@color/surface_container_low">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="PROBLEM"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/on_surface_variant" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="VERDICT"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/on_surface_variant" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="0.8"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="TIME"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/on_surface_variant"
                        android:gravity="end" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_gray" />

                <ProgressBar
                    android:id="@+id/progressSubmissions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:visibility="gone" />

                <!-- Submissions List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSubmissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="8dp" />
                    
                <TextView
                    android:id="@+id/tvEmptySubmissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No recent submissions"
                    android:gravity="center"
                    android:textColor="@color/on_surface_variant"
                    android:layout_marginTop="32dp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
