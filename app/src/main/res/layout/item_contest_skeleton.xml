<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_dark_card">

    <!-- Top padding strip -->
    <View android:layout_width="match_parent" android:layout_height="16dp" />

    <!-- Badge placeholders -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="16dp" android:layout_marginBottom="12dp">
        <View android:layout_width="64dp" android:layout_height="20dp"
            android:background="@color/surface_container_high" android:layout_marginEnd="8dp" />
        <View android:layout_width="56dp" android:layout_height="20dp"
            android:background="@color/surface_container_high" />
    </LinearLayout>

    <!-- Title placeholder -->
    <View android:layout_width="240dp" android:layout_height="18dp"
        android:background="@color/surface_container_high"
        android:layout_marginHorizontal="16dp" android:layout_marginBottom="6dp" />
    <View android:layout_width="180dp" android:layout_height="14dp"
        android:background="@color/surface_container"
        android:layout_marginHorizontal="16dp" android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/stroke_gray" />

    <!-- Duration + Timer row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <View android:layout_width="60dp" android:layout_height="10dp"
                android:background="@color/surface_container" android:layout_marginBottom="4dp" />
            <View android:layout_width="90dp" android:layout_height="14dp"
                android:background="@color/surface_container_high" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <View android:layout_width="60dp" android:layout_height="10dp"
                android:background="@color/surface_container" android:layout_marginBottom="4dp" />
            <View android:layout_width="100dp" android:layout_height="22dp"
                android:background="@color/surface_container_high" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/stroke_gray" />

    <!-- Buttons row placeholder -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="end">
        <View android:layout_width="52dp" android:layout_height="52dp"
            android:background="@color/surface_container_high" android:layout_marginEnd="1dp" />
        <View android:layout_width="52dp" android:layout_height="52dp"
            android:background="@color/surface_container_high" android:layout_marginEnd="1dp" />
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"
            android:background="@color/surface_container_high" />
    </LinearLayout>

</LinearLayout>