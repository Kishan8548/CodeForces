<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_black"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp">

    <!-- ── LOGO + APP NAME ───────────────────────────────── -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/cf_logo"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CF COMPANION"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/archivo_black"
        android:textColor="@color/on_surface"
        android:letterSpacing="-0.02"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The smart companion for competitive programmers"
        android:textSize="13sp"
        android:fontFamily="@font/space_mono_bold"
        android:textColor="@color/on_surface_variant"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="64dp" />

    <!-- ── FEATURE CHIPS ROW ─────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="64dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_dark_card"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/btn_star" app:tint="@color/on_surface" android:layout_gravity="center" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Rank\nThemes" android:textSize="10sp" android:fontFamily="@font/space_mono_bold"
                android:textColor="@color/on_surface_variant" android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_dark_card"
            android:layout_marginEnd="8dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/friend_icon" app:tint="@color/on_surface" android:layout_gravity="center" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="In-App\nFriends" android:textSize="10sp" android:fontFamily="@font/space_mono_bold"
                android:textColor="@color/on_surface_variant" android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_dark_card">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_compass" app:tint="@color/on_surface" android:layout_gravity="center" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Battle\nMode" android:textSize="10sp" android:fontFamily="@font/space_mono_bold"
                android:textColor="@color/on_surface_variant" android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── GOOGLE SIGN-IN BUTTON ─────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="@color/rank_newbie_primary_dim" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="CONTINUE WITH GOOGLE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/space_mono_bold"
            android:letterSpacing="0.08"
            android:textColor="@color/rank_newbie_on_primary"
            android:backgroundTint="@color/rank_newbie_primary"
            app:cornerRadius="0dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_user"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
    </FrameLayout>

    <!-- ── SKIP / CONTINUE WITHOUT AUTH ─────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSkipAuth"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="SKIP — BROWSE WITHOUT ACCOUNT"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="@font/space_mono_bold"
        android:letterSpacing="0.02"
        android:textColor="@color/on_surface_variant"
        android:backgroundTint="@android:color/transparent"
        app:strokeColor="@color/stroke_gray"
        app:strokeWidth="1dp"
        app:cornerRadius="0dp"
        app:elevation="0dp" />

    <!-- ── DISCLAIMER ────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Signing in unlocks Friends, Bookmarks, Battle Mode.\nNo CF password needed — Google account only."
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="@color/on_surface_variant"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginTop="24dp" />

    <!-- Loading overlay -->
    <ProgressBar
        android:id="@+id/progressAuth"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/rank_newbie_primary"
        android:visibility="gone"
        android:layout_marginTop="16dp" />

</LinearLayout>
